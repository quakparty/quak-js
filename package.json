{
  "name": "@quak/js",
  "version": "0.9.10",
  "description": "JavaScript/TypeScript client for the Quak API (quak.party): text-to-speech announcements, sounds and clips on Sonos speakers",
  "keywords": [
    "quak",
    "sonos",
    "speakers",
    "announcements",
    "text-to-speech",
    "tts",
    "smart-home",
    "api",
    "client",
    "openapi"
  ],
  "homepage": "https://quak.party",
  "bugs": {
    "url": "https://github.com/quakparty/quak-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quakparty/quak-js.git"
  },
  "license": "MIT",
  "author": "Mike Lieser",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun scripts/sync-version.ts && rm -rf dist && tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "generate": "bun scripts/generate.ts && bun scripts/docs.ts",
    "docs": "bun scripts/docs.ts",
    "release": "bun scripts/release.ts",
    "prepublishOnly": "bun run lint && bun test && bun run build"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  }
}
